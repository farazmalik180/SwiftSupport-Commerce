# Copy this file to `.env` and fill in your key. Never commit `.env`.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: model overrides (both are free-tier and support tool calling)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional: pin "today" so the mock data (anchored to 2026-10-21) gives
# deterministic refund decisions. Remove to use the real current date.
REFERENCE_DATE=2026-10-21

# Optional: LangSmith tracing (free tier at https://smith.langchain.com).
# Every agent turn, LLM call and tool call is traced. Note: prompts and customer messages
# are sent to LangSmith, so only enable it with data you are happy to share.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=swiftsupport-commerce
